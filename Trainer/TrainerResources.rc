#include <windows.h>
#include "SuiteBranding.h"

101 ICON "../assets/suite.ico"
102 RCDATA "../Installer/Update.ps1"
103 RCDATA "../CHANGELOG.md"
104 RCDATA "../Installer/Install.ps1"
105 RCDATA "SeedOrder.hlsl"
106 RCDATA "SeedOrderKernel.hlsli"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION SUITE_VERSION_COMPONENTS
 PRODUCTVERSION SUITE_VERSION_COMPONENTS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", SUITE_AUTHOR
            VALUE "FileDescription", SUITE_PRODUCT_NAME
            VALUE "FileVersion", SUITE_VERSION
            VALUE "InternalName", "ItStealsTrainer"
            VALUE "OriginalFilename", "ItStealsTrainer.exe"
            VALUE "ProductName", SUITE_PRODUCT_NAME
            VALUE "ProductVersion", SUITE_VERSION
            VALUE "Comments", "Vibe-coded project. See the repository for development credits."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
